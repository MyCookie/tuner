#!/usr/bin/env bash
# Pre-commit gate (09-git-workflow.md §6): ruff, unit tests, and hard blocks on
# .env, pickle/torch-save-load references, and secret-shaped values in staged
# content (docs/spec/08-test-specs/README.md "Secret scanning").
set -euo pipefail

# No `cd` here (unlike gate.sh): git always invokes hooks with CWD already at the
# repo root, and `$0` when git follows the .git/hooks/pre-commit symlink is that
# symlink's own path, not scripts/pre-commit's -- `cd "$(dirname "$0")/.."` would
# land in `.git/`, not the repo root, and every command below would silently look
# in the wrong place (confirmed live: `ruff .`/`pytest` both found nothing).

staged_files() {
    git diff --cached --name-only --diff-filter=ACM
}

if staged_files | grep -qx '\.env'; then
    echo "pre-commit: refusing to commit .env" >&2
    exit 1
fi

banned=0
while IFS= read -r file; do
    case "$file" in
        *.py)
            if git show ":$file" | grep -nE 'pickle\.(dump|load)|torch\.(save|load)\(' >&2; then
                echo "pre-commit: $file references a banned pickle/torch.save/load call" >&2
                banned=1
            fi
            ;;
    esac
done < <(staged_files)

if [ "$banned" -ne 0 ]; then
    exit 1
fi

mapfile -t staged < <(staged_files)
if [ "${#staged[@]}" -gt 0 ]; then
    uv run python scripts/check_secrets.py "${staged[@]}"
fi

uv run ruff check .
uv run ruff format --check .
uv run pytest
