# Copy to .env and fill in real values. .env is git-ignored; never commit it.
# No credential ever appears in docker-compose.yaml, configs, or code
# (05-infrastructure.md §1, CLAUDE.md hard rule 3) — env vars only.

# --- MinIO root (admin) credentials — bootstrap-only, never given to a stage.
MINIO_ROOT_USER=changeme-minio-root-user
MINIO_ROOT_PASSWORD=changeme-minio-root-password

# --- Per-stage MinIO credentials, created by scripts/bootstrap_minio.py and
# mapped by docker-compose.yaml into each stage container's canonical
# TUNER_S3_ACCESS_KEY/TUNER_S3_SECRET_KEY (05-infrastructure.md §5 IAM matrix).
INGESTOR_S3_ACCESS_KEY=changeme-ingestor-access-key
INGESTOR_S3_SECRET_KEY=changeme-ingestor-secret-key
CLEANER_S3_ACCESS_KEY=changeme-cleaner-access-key
CLEANER_S3_SECRET_KEY=changeme-cleaner-secret-key
JUDGE_S3_ACCESS_KEY=changeme-judge-access-key
JUDGE_S3_SECRET_KEY=changeme-judge-secret-key
TOKENIZER_S3_ACCESS_KEY=changeme-tokenizer-access-key
TOKENIZER_S3_SECRET_KEY=changeme-tokenizer-secret-key
TRAINER_S3_ACCESS_KEY=changeme-trainer-access-key
TRAINER_S3_SECRET_KEY=changeme-trainer-secret-key
SMOKE_S3_ACCESS_KEY=changeme-smoke-access-key
SMOKE_S3_SECRET_KEY=changeme-smoke-secret-key
REGISTRY_OPS_S3_ACCESS_KEY=changeme-registry-ops-access-key
REGISTRY_OPS_S3_SECRET_KEY=changeme-registry-ops-secret-key
MLFLOW_S3_ACCESS_KEY=changeme-mlflow-access-key
MLFLOW_S3_SECRET_KEY=changeme-mlflow-secret-key

# --- Canonical TUNER_S3_* vars (01-architecture.md §4.3). Compose injects
# these per-container from the per-stage pairs above; set them directly only
# when running a single stage from a host venv instead of compose (the GPU
# fallback, 05-infrastructure.md §3) — to that one stage's credentials.
# For a local test run, set the two below to the MINIO_ROOT_USER/PASSWORD pair
# above: the integration suite drives StorageClient across every tier, so no
# single per-stage principal has the grants it needs.
TUNER_S3_ENDPOINT=http://localhost:9000
TUNER_S3_ACCESS_KEY=changeme-s3-access-key
TUNER_S3_SECRET_KEY=changeme-s3-secret-key
TUNER_S3_REGION=us-east-1

# --- MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Judge endpoint (OpenAI-compatible; host Ollama, a lab vLLM box, etc.)
TUNER_JUDGE_BASE_URL=http://host.docker.internal:11434/v1
TUNER_JUDGE_API_KEY=changeme-judge-api-key

# --- Hugging Face (gated models)
HF_TOKEN=changeme-hf-token
